---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import { logo } from '../data/moments';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'shop' | 'podcast';
}

const {
  title,
  description = 'Apparel and a podcast for people who make time for the things they love. Founded by Ron LaBeau. Wear the moment.',
  current = 'home',
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const og = await getImage({ src: logo, width: 1200, format: 'png' });
const icon = await getImage({ src: logo, width: 96, format: 'png' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6efe1" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(og.src, site.url).href} />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:ital,wght@0,400..700;1,400&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>
  <body data-page={current}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>
