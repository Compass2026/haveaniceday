---
import { Image } from 'astro:assets';
import { collection, paceLabel } from '../data/moments';

// The home page teaser: designs laid out like a sheet of die-cut stickers.
const picks = collection.filter((m) => m.pace !== 'signature' || m.slug === '02-peace-sign').slice(0, 5);
const tilts = [-4, 3, -2, 5, -3, 2];
---

<section class="sheet section" aria-labelledby="sheet-title">
  <div class="wrap">
    <div class="sheet__head">
      <div class="sheet__titles">
        <p class="eyebrow">The collection</p>
        <h2 class="h-xl" id="sheet-title">Wear the <span class="say">moment.</span></h2>
      </div>
      <div class="sheet__aside">
        <p class="lede">
          Every design starts with a real moment. Pick the one that sounds like your Saturday. The first drop of tees and
          sweatshirts is on its way.
        </p>
        <a class="btn" href="/shop">Browse all designs</a>
      </div>
    </div>

    <ul class="sheet__board">
      {
        picks.map((m, i) => (
          <li class:list={['sheet__item', `sheet__item--${i}`]} style={`--tilt:${tilts[i % tilts.length]}deg`}>
            <a href={`/shop#${m.slug}`} class="sheet__link">
              <Image
                class="sheet__img"
                src={m.image!}
                alt={m.alt}
                widths={[300, 520, 800]}
                sizes={i === 0 ? '(max-width: 760px) 80vw, 40vw' : '(max-width: 760px) 42vw, 22vw'}
                format="webp"
                loading="lazy"
              />
              <span class="tag sheet__tag">
                <b>No. {m.no}</b> {m.name}
                <span class="visually-hidden">, {paceLabel[m.pace]}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sheet__head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .sheet__titles {
    display: grid;
    gap: 1rem;
  }
  .sheet__titles .say {
    color: var(--orange-ink);
  }
  .sheet__aside {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  /* One kraft sheet; stickers sit on it at slight angles */
  .sheet__board {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(0, auto);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background-color: var(--paper-2);
    background-image: radial-gradient(rgb(13 27 61 / 0.12) 1px, transparent 1.3px);
    background-size: 18px 18px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .sheet__item {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sheet__item--0 {
    grid-column: 1 / span 6;
    grid-row: 1 / span 2;
  }
  .sheet__item--1 {
    grid-column: 7 / span 3;
  }
  .sheet__item--2 {
    grid-column: 10 / span 3;
    padding-top: 2rem;
  }
  .sheet__item--3 {
    grid-column: 7 / span 3;
  }
  .sheet__item--4 {
    grid-column: 10 / span 3;
  }
  .sheet__link {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    text-decoration: none;
    width: 100%;
  }
  .sheet__img {
    width: 100%;
    max-height: 340px;
    object-fit: contain;
    filter: drop-shadow(0 10px 14px rgb(13 27 61 / 0.2)) drop-shadow(0 1px 1px rgb(13 27 61 / 0.2));
    transform: rotate(var(--tilt));
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.3s ease;
  }
  .sheet__item--0 .sheet__img {
    max-height: 560px;
  }
  .sheet__link:hover .sheet__img,
  .sheet__link:focus-visible .sheet__img {
    transform: rotate(0deg) translateY(-8px) scale(1.03);
    filter: drop-shadow(0 22px 22px rgb(13 27 61 / 0.22)) drop-shadow(0 1px 1px rgb(13 27 61 / 0.2));
  }
  .sheet__tag {
    background: var(--paper-3);
    transform: rotate(calc(var(--tilt) * -0.5));
  }

  @media (max-width: 860px) {
    .sheet__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .sheet__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sheet__item[class*='sheet__item--'] {
      grid-column: auto;
      grid-row: auto;
      padding-top: 0;
    }
    .sheet__item--0 {
      grid-column: 1 / -1 !important;
    }
    .sheet__img {
      max-height: 200px;
    }
    .sheet__tag {
      white-space: normal;
      font-size: 0.72rem;
      max-width: 100%;
    }
    .sheet__item--0 .sheet__img {
      max-height: 340px;
    }
  }
</style>
