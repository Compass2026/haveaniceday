---
// The three-step "how a nice day happens". Order matters here, so the
// steps are numbered and joined by a dotted route like a day's itinerary.
const steps = [
  {
    title: 'Pick your thing.',
    body: 'The ride, the round, the recipe. Whatever makes a day feel like it was yours.',
  },
  {
    title: 'Put it on the calendar.',
    body: 'Pencil it in like it matters, because it does. Nice days rarely happen by accident.',
  },
  {
    title: 'Tell somebody.',
    body: 'Wear it, share it, or come on the podcast and tell Ron the whole story.',
  },
];
---

<section class="steps section" aria-labelledby="steps-title">
  <div class="wrap steps__grid">
    <h2 class="h-lg steps__title" id="steps-title">
      Make it a nice day <span class="say steps__say">on purpose.</span>
    </h2>
    <ol class="steps__list">
      {
        steps.map((s, i) => (
          <li class="steps__item">
            <span class="steps__num" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="steps__h">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    padding-top: 0;
  }
  .steps__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  .steps__title {
    max-width: 13em;
  }
  .steps__say {
    color: var(--orange-ink);
  }
  .steps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    position: relative;
    counter-reset: step;
  }
  /* The dotted route between stops */
  .steps__list::before {
    content: '';
    position: absolute;
    left: 28px;
    right: 10%;
    top: 27px;
    border-top: 3px dotted var(--line-strong);
  }
  .steps__item {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    max-width: 22rem;
  }
  .steps__item:nth-child(2) {
    padding-top: 1.5rem;
  }
  .steps__item:nth-child(3) {
    padding-top: 3rem;
  }
  .steps__num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.5rem;
    box-shadow: 0 0 0 8px var(--paper);
    position: relative;
  }
  .steps__item:nth-child(2) .steps__num {
    background: var(--blue);
  }
  .steps__item:nth-child(3) .steps__num {
    background: var(--orange);
    color: var(--ink);
  }
  .steps__h {
    font-size: var(--step-2);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-top: 0.5rem;
  }
  .steps__item p {
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .steps__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps__list::before {
      left: 27px;
      right: auto;
      top: 28px;
      bottom: 28px;
      border-top: 0;
      border-left: 3px dotted var(--line-strong);
    }
    .steps__item,
    .steps__item:nth-child(2),
    .steps__item:nth-child(3) {
      grid-template-columns: 56px minmax(0, 1fr);
      column-gap: 1.25rem;
      padding-top: 0;
      max-width: none;
    }
    .steps__num {
      grid-row: span 2;
    }
    .steps__h {
      margin-top: 0.6rem;
    }
  }
</style>
