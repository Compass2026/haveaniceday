---
// Phone-only action bar. It appears once the visitor scrolls past the first
// screen and steps aside near the footer.
---

<nav class="mobile-bar" aria-label="Quick links" data-mobile-bar>
  <a class="mobile-bar__item mobile-bar__item--shop" href="/shop">Shop the collection</a>
  <a class="mobile-bar__item" href="/podcast">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Zm7 9a7 7 0 0 1-14 0m7 7v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    Podcast
  </a>
</nav>

<style>
  .mobile-bar {
    display: none;
  }
  @media (max-width: 760px) {
    .mobile-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 8px;
      padding: 8px max(12px, env(safe-area-inset-right, 0px)) calc(8px + env(safe-area-inset-bottom, 0px))
        max(12px, env(safe-area-inset-left, 0px));
      background: rgb(246 239 225 / 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--line);
      transform: translateY(110%);
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .mobile-bar[data-show] {
      transform: none;
    }
  }
  .mobile-bar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 48px;
    border-radius: 999px;
    border: 2px solid var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--ink);
  }
  .mobile-bar__item svg {
    width: 18px;
    height: 18px;
  }
  .mobile-bar__item--shop {
    background: var(--ink);
    color: var(--paper);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-bar]');
  const footer = document.querySelector('footer');
  if (bar) {
    let pastFirst = false;
    let nearFooter = false;
    const update = () => bar.toggleAttribute('data-show', pastFirst && !nearFooter);
    window.addEventListener(
      'scroll',
      () => {
        pastFirst = window.scrollY > window.innerHeight * 0.7;
        update();
      },
      { passive: true },
    );
    if (footer) {
      new IntersectionObserver(([entry]) => {
        nearFooter = entry.isIntersecting;
        update();
      }).observe(footer);
    }
  }
</script>
